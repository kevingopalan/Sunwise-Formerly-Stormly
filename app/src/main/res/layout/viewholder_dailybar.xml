<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainer">
    <LinearLayout
        android:id="@+id/text_hourlyhome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/text_hourlyhome">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:id="@+id/hourTxt"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="day"
                android:fontFamily="@font/montsemibold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                android:layout_gravity="center_vertical"/>
        </LinearLayout>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/not_available"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:id="@+id/loTempTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--º"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.65"
            android:fontFamily="@font/montsemibold"
            android:textSize="16sp" />
        <com.venomdevelopment.sunwise.VerticalTemperatureBar
            android:id="@+id/tempBar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="8dp"
            android:layout_marginLeft="8dp" />
        <TextView
            android:id="@+id/hiTempTxt"
            android:layout_width="wrap_content"
            android:fontFamily="@font/montsemibold"
            android:layout_height="wrap_content"
            android:text="--º"
            android:layout_marginLeft="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />
        <ImageView
            android:layout_width="wrap_content"
            android:id="@+id/arrow"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_keyboard_arrow_down_24"
            android:layout_marginStart="12dp"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>
    <View
        android:layout_height="1dp"
        android:layout_width="match_parent"
        android:background="?attr/colorOnSurface"
        android:alpha="0.1"
        app:layout_constraintTop_toBottomOf="@id/text_hourlyhome"/>
    <LinearLayout
        android:id="@+id/precipitationLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/text_hourlyhome"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:id="@+id/daypreclayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="0dp"
            android:paddingBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/text_hourlyhome"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day"
                android:fontFamily="@font/montsemibold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/statTxt"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text = "---"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="10dp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/precimg"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/rainy_24px"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:id="@+id/precipitationTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/humidityIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/humidityicon"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:id="@+id/humidityTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\?"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/colorOnSurface"
            android:alpha="0.1"/>
        <LinearLayout
            android:id="@+id/nightpreclayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="0dp"
            android:paddingBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/text_hourlyhome"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Night"
                android:fontFamily="@font/montsemibold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/nightStatTxt"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text = "---"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="10dp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/nightprecimg"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/rainy_24px"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:id="@+id/nightPrecipitationTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/nightHumidityIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/humidityicon"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:id="@+id/nightHumidityTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="\?"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_height="1dp"
        android:layout_width="match_parent"
        android:background="?attr/colorOnSurface"
        android:alpha="0.1"
        app:layout_constraintTop_toBottomOf="@id/precipitationLayout"/>

</androidx.constraintlayout.widget.ConstraintLayout>
