<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".ForecastFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/locationHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/locationDisplay"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:theme="@style/Theme.Material3.Dark"
            android:text="Location"
            android:textColor="?attr/colorOnSurface"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="18sp"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toStartOf="@+id/saveLocationButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:fontFamily="@font/montsemibold"/>

        <Button
            android:id="@+id/saveLocationButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="@font/montsemibold"
            android:theme="@style/Theme.Material3.Dark"
            android:textAllCaps="false"
            android:letterSpacing="0.02"
            android:text="Save"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            app:backgroundTint="@android:color/transparent"
            app:layout_constraintStart_toEndOf="@+id/locationDisplay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/locationDisplay"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
        app:layout_constraintTop_toBottomOf="@id/locationHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animation_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:layout_constraintHeight="80dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth="80dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/clear_day" />

            <TextView
                android:id="@+id/currentTempText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montsemibold"
                android:text="--º"
                android:textColor="?attr/colorOnSurface"
                android:theme="@style/Theme.Material3.Dark"
                android:textSize="72sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/animation_view" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/hltemps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/currentTempText">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textColor="?attr/colorOnSurface"
                    android:text="H:"
                    android:id="@+id/highlabel"
                    android:fontFamily="@font/montsemibold"
                    android:textSize="20sp"/>
                <TextView
                    android:id="@+id/highTempText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="---"
                    android:layout_marginStart="4dp"
                    android:textColor="?attr/colorOnSurface"
                    android:theme="@style/Theme.Material3.Dark"
                    android:textSize="20sp"
                    app:layout_constraintStart_toEndOf="@id/highlabel"
                    app:layout_constraintEnd_toStartOf="@+id/slash"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montsemibold"
                    app:layout_constraintEnd_toStartOf="@+id/lowTempText"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textColor="?attr/colorOnSurface"
                    android:text="L:"
                    android:id="@+id/slash"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/lowTempText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="---"
                    android:textColor="?attr/colorOnSurface"
                    android:theme="@style/Theme.Material3.Dark"
                    android:textSize="20sp"
                    app:layout_constraintStart_toEndOf="@+id/slash"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/text_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="@font/montreg"
                android:text="---"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface"
                android:theme="@style/Theme.Material3.Dark"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/hltemps"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:layout_editor_absoluteY="367dp" />

            <GridLayout
                android:id="@+id/basicinfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/main_background"
                android:columnCount="2"
                android:rowCount="2"
                android:padding="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_desc">

                <!-- Humidity Section -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:padding="8dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/humidityProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:progress="0"
                        app:indicatorSize="72dp"
                        app:trackThickness="6dp"
                        app:indicatorColor="?attr/colorPrimary"
                        app:trackColor="?attr/colorSurfaceVariant"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/humidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montreg"
                        android:text="--%"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@+id/humidityProgress"
                        app:layout_constraintEnd_toEndOf="@+id/humidityProgress"
                        app:layout_constraintStart_toStartOf="@+id/humidityProgress"
                        app:layout_constraintTop_toTopOf="@+id/humidityProgress" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montreg"
                        android:text="Humidity"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/humidityProgress" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Precipitation Section -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:padding="8dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/precipitationProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:progress="0"
                        app:indicatorSize="72dp"
                        app:trackThickness="6dp"
                        app:indicatorColor="?attr/colorTertiary"
                        app:trackColor="?attr/colorSurfaceVariant"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/precipitation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montreg"
                        android:text="--%"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@+id/precipitationProgress"
                        app:layout_constraintEnd_toEndOf="@+id/precipitationProgress"
                        app:layout_constraintStart_toStartOf="@+id/precipitationProgress"
                        app:layout_constraintTop_toTopOf="@+id/precipitationProgress" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/montreg"
                        android:text="Precipitation"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/precipitationProgress" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Wind Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_wind_24"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/wind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/montreg"
                        android:text="--mph"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montreg"
                        android:text="Wind"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Dew Point Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/humidityicon"
                        app:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/dewpoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/montreg"
                        android:text="--°"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montreg"
                        android:text="Dew Point"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>

            </GridLayout>

            <TextView
                android:id="@+id/hourlyforecastlabel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginTop="20dp"
                android:text="Hourly Forecast"
                android:textSize="16dp"
                android:fontFamily="@font/montsemibold"
                android:textColor="@color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/basicinfo" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hourlyRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="12dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hourlyforecastlabel"
                tools:ignore="UnusedAttribute" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/dailygraphbetacontainer"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hourlyRecyclerView"
                android:layout_margin="12dp"
                android:fontFamily = "@font/montsemibold">
                <TextView
                    android:id="@+id/dailygraphlabelbeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montsemibold"
                    android:layout_marginBottom="10dp"
                    android:text="Daily Forecast"
                    android:textSize="16dp"
                    android:textColor="?attr/colorOnSurface" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dailygraphbeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToOutline="true"
                    android:clipChildren="true"
                    android:outlineProvider="background"
                    android:background="@drawable/mbclip"
                    android:overScrollMode="never"
                    />
            </LinearLayout>

            <com.google.android.gms.ads.AdView
                android:id="@+id/forecast_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:adSize="MEDIUM_RECTANGLE"
                app:adUnitId="@string/ad_unit_forecast_fragment"
                app:layout_constraintTop_toBottomOf="@+id/dailygraphbetacontainer" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/hourlygraph"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/forecast_ad"
                android:layout_margin="12dp"
                android:background="@drawable/main_background">
                <TextView
                    android:id="@+id/hourlygraphlabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="Hourly Forecast graph"
                    android:fontFamily="@font/montsemibold"
                    android:textSize="16dp"
                    android:textColor="?attr/colorOnSurface" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="20dp"
                    android:overScrollMode="never"
                    android:background="?attr/colorSurfaceContainer"
                    android:paddingBottom="12dp">

                    <com.venomdevelopment.sunwise.WeatherHourlyChart
                        android:id="@+id/customHourlyChart"
                        android:layout_width="wrap_content"
                        android:layout_height="260dp" />

                </HorizontalScrollView>
            </LinearLayout>
            <View
                app:layout_constraintTop_toBottomOf="@id/hourlygraph"
                android:layout_width="match_parent"
                android:layout_height="120dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/reloadFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/baseline_refresh_24"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="?attr/colorOnPrimary"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="?android:colorBackground"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.loadingindicator.LoadingIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:indicatorSize="64dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>